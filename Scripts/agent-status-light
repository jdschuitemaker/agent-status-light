#!/bin/zsh
# Updates the state read by the Agent Status Light menu-bar app.
set -euo pipefail

status_dir="$HOME/Library/Application Support/AgentStatusLight"
sessions_dir="$status_dir/sessions"

sanitize() {
  print -r -- "${1//[^A-Za-z0-9_.-]/_}"
}

write_state() {
  local state="$1"
  local source_name="${2:-cli}"
  local session_id="${3:-}"
  local label="${4:-}"
  local terminal="${5:-}"
  local tty="${6:-}"
  local terminal_pid="${7:-0}"
  local safe_source; safe_source="$(sanitize "$source_name")"
  mkdir -p "$status_dir"
  local timestamp tmp_file
  timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local escaped_session="${session_id//\\/\\\\}"; escaped_session="${escaped_session//\"/\\\"}"
  local escaped_label="${label//\\/\\\\}"; escaped_label="${escaped_label//\"/\\\"}"
  local escaped_terminal="${terminal//\\/\\\\}"; escaped_terminal="${escaped_terminal//\"/\\\"}"
  local escaped_tty="${tty//\\/\\\\}"; escaped_tty="${escaped_tty//\"/\\\"}"
  terminal_pid="${terminal_pid//[^0-9]/}"; terminal_pid="${terminal_pid:-0}"
  local json="{\"state\":\"$state\",\"updatedAt\":\"$timestamp\",\"source\":\"$source_name\",\"session\":\"$escaped_session\",\"label\":\"$escaped_label\",\"terminal\":\"$escaped_terminal\",\"tty\":\"$escaped_tty\",\"terminalPid\":$terminal_pid}"
  if [[ -n "$session_id" ]]; then
    local safe_session; safe_session="$(sanitize "$session_id")"
    local session_file="$sessions_dir/${safe_source}__${safe_session}.json"
    if [[ "$state" == off ]]; then
      rm -f "$session_file"
    else
      mkdir -p "$sessions_dir"
      tmp_file="$(mktemp "$sessions_dir/session.XXXXXX")"
      print -r -- "$json" > "$tmp_file"
      mv -f "$tmp_file" "$session_file"
    fi
  fi
  tmp_file="$(mktemp "$status_dir/status.XXXXXX")"
  print -r -- "$json" > "$tmp_file"
  mv -f "$tmp_file" "$status_dir/status.${safe_source}.json"
}

if [[ "${1:-}" == run ]]; then
  source_name="${2:-cli}"
  [[ "${3:-}" == -- ]] || { print -u2 "Usage: agent-status-light run [source] -- command [args...]"; exit 64; }
  shift 3
  (( $# > 0 )) || { print -u2 "Usage: agent-status-light run [source] -- command [args...]"; exit 64; }
  write_state working "$source_name"
  set +e
  "$@"
  exit_code=$?
  set -e
  if (( exit_code == 0 )); then
    write_state completed "$source_name"
  else
    write_state failed "$source_name"
  fi
  exit "$exit_code"
fi

case "${1:-}" in
  working|thinking|busy) state=working ;;
  completed|complete|done|success) state=completed ;;
  failed|failure|error) state=failed ;;
  awaiting-input|input|approval) state=awaiting-input ;;
  off|idle|clear) state=off ;;
  *)
    print -u2 "Usage: agent-status-light {working|done|error|off} [source] [session-id] [label]"
    print -u2 "       agent-status-light run [source] -- command [args...]"
    exit 64
    ;;
esac

write_state "$state" "${2:-cli}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-0}"
