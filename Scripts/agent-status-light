#!/bin/zsh
# Updates the state read by the Agent Status Light menu-bar app.
set -euo pipefail

status_dir="$HOME/Library/Application Support/AgentStatusLight"

write_state() {
  local state="$1"
  local source_name="${2:-cli}"
  mkdir -p "$status_dir"
  local timestamp tmp_file
  timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  tmp_file="$(mktemp "$status_dir/status.XXXXXX")"
  print -r -- "{\"state\":\"$state\",\"updatedAt\":\"$timestamp\",\"source\":\"$source_name\"}" > "$tmp_file"
  mv -f "$tmp_file" "$status_dir/status.json"
}

if [[ "${1:-}" == run ]]; then
  source_name="${2:-cli}"
  [[ "${3:-}" == -- ]] || { print -u2 "Usage: agent-status-light run [source] -- command [args...]"; exit 64; }
  shift 3
  (( $# > 0 )) || { print -u2 "Usage: agent-status-light run [source] -- command [args...]"; exit 64; }
  write_state working "$source_name"
  set +e
  "$@"
  exit_code=$?
  set -e
  if (( exit_code == 0 )); then
    write_state completed "$source_name"
  else
    write_state failed "$source_name"
  fi
  exit "$exit_code"
fi

case "${1:-}" in
  working|thinking|busy) state=working ;;
  completed|complete|done|success) state=completed ;;
  failed|failure|error) state=failed ;;
  awaiting-input|input|approval) state=awaiting-input ;;
  off|idle|clear) state=off ;;
  *)
    print -u2 "Usage: agent-status-light {working|done|error|off} [source]"
    print -u2 "       agent-status-light run [source] -- command [args...]"
    exit 64
    ;;
esac

write_state "$state" "${2:-cli}"
